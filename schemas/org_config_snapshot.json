{
  "$defs": {
    "AssetEntry": {
      "additionalProperties": true,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        },
        "subnet_membership": {
          "minLength": 1,
          "title": "Subnet Membership",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "subnet_membership"
      ],
      "title": "AssetEntry",
      "type": "object"
    },
    "AssetsAndAssetGroups": {
      "additionalProperties": true,
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/AssetEntry"
          },
          "minItems": 1,
          "title": "Entries",
          "type": "array"
        }
      },
      "required": [
        "entries"
      ],
      "title": "AssetsAndAssetGroups",
      "type": "object"
    },
    "BusinessContext": {
      "additionalProperties": true,
      "properties": {},
      "title": "BusinessContext",
      "type": "object"
    },
    "CircuitBreakerPolicy": {
      "additionalProperties": false,
      "properties": {
        "failure_threshold": {
          "exclusiveMinimum": 0,
          "title": "Failure Threshold",
          "type": "integer"
        },
        "success_reset_threshold": {
          "exclusiveMinimum": 0,
          "title": "Success Reset Threshold",
          "type": "integer"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "window_seconds",
        "failure_threshold",
        "success_reset_threshold"
      ],
      "title": "CircuitBreakerPolicy",
      "type": "object"
    },
    "ConsumerClockSkewPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_consumer_clock_skew_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Consumer Clock Skew Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_consumer_clock_skew_seconds"
      ],
      "title": "ConsumerClockSkewPolicy",
      "type": "object"
    },
    "ContainmentExclusions": {
      "additionalProperties": false,
      "properties": {
        "never_contain": {
          "items": {
            "$ref": "#/$defs/NeverContainEntry"
          },
          "minItems": 1,
          "title": "Never Contain",
          "type": "array"
        }
      },
      "required": [
        "never_contain"
      ],
      "title": "ContainmentExclusions",
      "type": "object"
    },
    "ContainmentPolicy": {
      "additionalProperties": false,
      "properties": {
        "default_action": {
          "enum": [
            "allow",
            "deny",
            "escalate",
            "auto_contain"
          ],
          "title": "Default Action",
          "type": "string"
        },
        "precedence": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precedence"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/ContainmentRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "default_action"
      ],
      "title": "ContainmentPolicy",
      "type": "object"
    },
    "ContainmentRule": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "allow",
            "deny",
            "escalate",
            "auto_contain"
          ],
          "title": "Action",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContainmentRuleTargetScope"
            },
            {
              "$ref": "#/$defs/ContainmentRuleAssetScope"
            },
            {
              "$ref": "#/$defs/ContainmentRuleCatchAllScope"
            }
          ],
          "title": "Scope"
        }
      },
      "required": [
        "name",
        "action",
        "scope"
      ],
      "title": "ContainmentRule",
      "type": "object"
    },
    "ContainmentRuleAssetScope": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "minLength": 1,
          "title": "Asset Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id"
      ],
      "title": "ContainmentRuleAssetScope",
      "type": "object"
    },
    "ContainmentRuleCatchAllScope": {
      "additionalProperties": false,
      "properties": {
        "catch_all": {
          "const": true,
          "default": true,
          "title": "Catch All",
          "type": "boolean"
        }
      },
      "title": "ContainmentRuleCatchAllScope",
      "type": "object"
    },
    "ContainmentRuleTargetScope": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "enum": [
            "host",
            "account"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "target_type",
        "target_id"
      ],
      "title": "ContainmentRuleTargetScope",
      "type": "object"
    },
    "DirectiveLifetimePolicy": {
      "additionalProperties": false,
      "properties": {
        "max_lifetime_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Lifetime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_lifetime_seconds"
      ],
      "title": "DirectiveLifetimePolicy",
      "type": "object"
    },
    "EmergencyNeverContainPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_lifetime_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Lifetime Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_lifetime_seconds"
      ],
      "title": "EmergencyNeverContainPolicy",
      "type": "object"
    },
    "KnownPrincipals": {
      "additionalProperties": true,
      "properties": {},
      "title": "KnownPrincipals",
      "type": "object"
    },
    "LatencyAndQueueAgingPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_queue_age_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Queue Age Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_queue_age_seconds"
      ],
      "title": "LatencyAndQueueAgingPolicy",
      "type": "object"
    },
    "NeverContainEntry": {
      "additionalProperties": false,
      "properties": {
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "target_type": {
          "enum": [
            "host",
            "account"
          ],
          "title": "Target Type",
          "type": "string"
        }
      },
      "required": [
        "target_type",
        "target_id"
      ],
      "title": "NeverContainEntry",
      "type": "object"
    },
    "NormalAdminPatterns": {
      "additionalProperties": true,
      "properties": {},
      "title": "NormalAdminPatterns",
      "type": "object"
    },
    "ProviderHealthCircuitBreakerPolicy": {
      "additionalProperties": false,
      "properties": {
        "failure_threshold": {
          "exclusiveMinimum": 0,
          "title": "Failure Threshold",
          "type": "integer"
        },
        "probe_rate_limit_per_minute": {
          "exclusiveMinimum": 0,
          "title": "Probe Rate Limit Per Minute",
          "type": "integer"
        },
        "success_reset_threshold": {
          "exclusiveMinimum": 0,
          "title": "Success Reset Threshold",
          "type": "integer"
        },
        "window_seconds": {
          "exclusiveMinimum": 0,
          "title": "Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "window_seconds",
        "failure_threshold",
        "success_reset_threshold",
        "probe_rate_limit_per_minute"
      ],
      "title": "ProviderHealthCircuitBreakerPolicy",
      "type": "object"
    },
    "ProvisionalAlertRateTargets": {
      "additionalProperties": false,
      "properties": {
        "burst_alerts_per_minute": {
          "exclusiveMinimum": 0,
          "title": "Burst Alerts Per Minute",
          "type": "integer"
        },
        "sustained_alerts_per_minute": {
          "exclusiveMinimum": 0,
          "title": "Sustained Alerts Per Minute",
          "type": "integer"
        }
      },
      "required": [
        "sustained_alerts_per_minute",
        "burst_alerts_per_minute"
      ],
      "title": "ProvisionalAlertRateTargets",
      "type": "object"
    },
    "RateLimitCeilings": {
      "additionalProperties": false,
      "properties": {
        "per_asset_group": {
          "exclusiveMinimum": 0,
          "title": "Per Asset Group",
          "type": "integer"
        },
        "per_host": {
          "exclusiveMinimum": 0,
          "title": "Per Host",
          "type": "integer"
        },
        "per_subnet": {
          "exclusiveMinimum": 0,
          "title": "Per Subnet",
          "type": "integer"
        }
      },
      "required": [
        "per_host",
        "per_subnet",
        "per_asset_group"
      ],
      "title": "RateLimitCeilings",
      "type": "object"
    },
    "RateLimitPolicy": {
      "additionalProperties": false,
      "properties": {
        "ceilings": {
          "$ref": "#/$defs/RateLimitCeilings"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        }
      },
      "required": [
        "scopes"
      ],
      "title": "RateLimitPolicy",
      "type": "object"
    },
    "RevocationFeedPolicy": {
      "additionalProperties": false,
      "properties": {
        "max_feed_export_retries": {
          "exclusiveMinimum": 0,
          "title": "Max Feed Export Retries",
          "type": "integer"
        },
        "max_revocation_feed_propagation_delay_seconds": {
          "exclusiveMinimum": 0,
          "title": "Max Revocation Feed Propagation Delay Seconds",
          "type": "integer"
        }
      },
      "required": [
        "max_revocation_feed_propagation_delay_seconds",
        "max_feed_export_retries"
      ],
      "title": "RevocationFeedPolicy",
      "type": "object"
    },
    "VersionMetadata": {
      "additionalProperties": true,
      "properties": {
        "config_version": {
          "minLength": 1,
          "title": "Config Version",
          "type": "string"
        },
        "org_id": {
          "minLength": 1,
          "title": "Org Id",
          "type": "string"
        }
      },
      "required": [
        "org_id",
        "config_version"
      ],
      "title": "VersionMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bound org-config snapshot at activation.",
  "properties": {
    "account_auto_contain_enabled": {
      "default": false,
      "title": "Account Auto Contain Enabled",
      "type": "boolean"
    },
    "assets_and_asset_groups": {
      "$ref": "#/$defs/AssetsAndAssetGroups"
    },
    "business_context": {
      "$ref": "#/$defs/BusinessContext"
    },
    "consumer_clock_skew_policy": {
      "$ref": "#/$defs/ConsumerClockSkewPolicy"
    },
    "containment_circuit_breaker_policy": {
      "$ref": "#/$defs/CircuitBreakerPolicy"
    },
    "containment_exclusions": {
      "$ref": "#/$defs/ContainmentExclusions"
    },
    "containment_policy": {
      "$ref": "#/$defs/ContainmentPolicy"
    },
    "directive_lifetime_policy": {
      "$ref": "#/$defs/DirectiveLifetimePolicy"
    },
    "emergency_never_contain_policy": {
      "$ref": "#/$defs/EmergencyNeverContainPolicy"
    },
    "known_principals": {
      "$ref": "#/$defs/KnownPrincipals"
    },
    "latency_and_queue_aging_policy": {
      "$ref": "#/$defs/LatencyAndQueueAgingPolicy"
    },
    "normal_admin_patterns": {
      "$ref": "#/$defs/NormalAdminPatterns"
    },
    "provider_health_circuit_breaker_policy": {
      "$ref": "#/$defs/ProviderHealthCircuitBreakerPolicy"
    },
    "provisional_alert_rate_targets": {
      "$ref": "#/$defs/ProvisionalAlertRateTargets"
    },
    "rate_limit_policy": {
      "$ref": "#/$defs/RateLimitPolicy"
    },
    "revocation_feed_policy": {
      "$ref": "#/$defs/RevocationFeedPolicy"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot_hash": {
      "description": "Canonical hash of binding body per docs/contracts.md \u00a73a.",
      "title": "Snapshot Hash",
      "type": "string"
    },
    "version_metadata": {
      "$ref": "#/$defs/VersionMetadata"
    }
  },
  "required": [
    "snapshot_hash",
    "version_metadata",
    "known_principals",
    "assets_and_asset_groups",
    "normal_admin_patterns",
    "containment_exclusions",
    "business_context",
    "containment_policy",
    "directive_lifetime_policy",
    "emergency_never_contain_policy",
    "rate_limit_policy",
    "provider_health_circuit_breaker_policy",
    "containment_circuit_breaker_policy",
    "revocation_feed_policy",
    "consumer_clock_skew_policy",
    "latency_and_queue_aging_policy",
    "provisional_alert_rate_targets"
  ],
  "title": "OrgConfigSnapshot",
  "type": "object"
}
